# Copia este archivo como ".env" (sin el ".example") y rellena tus datos.
# El ".env" está en .gitignore: nunca lo subas al repositorio.

# Token del bot de Telegram (te lo da @BotFather).
VITE_TELEGRAM_TOKEN=

# chat_id del destinatario (tu cuenta o el grupo que recibirá el S.O.S).
# Consíguelo abriendo: https://api.telegram.org/bot<TU_TOKEN>/getUpdates
# y buscando "chat":{"id": ...} después de enviar un mensaje al bot.
VITE_TELEGRAM_CHAT_ID=

# ADVERTENCIA: al compilar, estas variables quedan dentro del JavaScript del sitio.
# La app es 100% cliente (sin backend), así que cualquiera con el enlace podría
# verlas. Para una demo es aceptable; si el token se filtra, revócalo en BotFather
# con /revoke y genera uno nuevo.
